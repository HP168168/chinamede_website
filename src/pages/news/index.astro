---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNewsItems, getSeoFor, getSiteConfig } from '../../lib/strapi';

const [seo, site, newsItems] = await Promise.all([getSeoFor('/news/'), getSiteConfig(), getNewsItems()]);

// 机构动态：后台「机构动态与商业资讯」中栏目为「机构动态」的条目
const items = newsItems.filter((item) => item.channel === 'news');
---

<BaseLayout title={seo.title} description={seo.description} keywords={seo.keywords} route="/news/">
  <section class="page-banner">
      <div class="container">
        <h1>机构动态</h1>
        <p>美迪时代教育最新官方动态与校区活动</p>
        <div class="breadcrumb">
          <a href="/">首页</a> / 机构动态
        </div>
      </div>
    </section>

    <section class="section news-section">
      <div class="container">
        <div class="section-title">
          <h2>最新动态</h2>
          <p>了解美迪时代教育的课程升级、校区活动、企业合作与就业成果</p>
        </div>
        <div class="news-grid">
          {items.map((item) => (
            <article class="news-card">
              <div class="news-image">{item.emoji}</div>
              <div class="news-content">
                <div class="news-date">{item.date}</div>
                <h3>{item.title}</h3>
                <p>{item.summary}</p>
                <a href="#" class="read-more">阅读更多 →</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="container">
        <h2>关注美迪，获取更多动态</h2>
        <p>拨打{site.telephone}或预约试听，第一时间了解课程升级与优惠活动</p>
        <a href="/contact/" class="btn btn-red">立即预约</a>
      </div>
    </section>

</BaseLayout>
