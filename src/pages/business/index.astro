---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNewsItems, getSeoFor } from '../../lib/strapi';

const [seo, newsItems] = await Promise.all([getSeoFor('/business/'), getNewsItems()]);

// 商业资讯：后台「机构动态与商业资讯」中栏目为「商业资讯」的条目
const items = newsItems.filter((item) => item.channel === 'business');
---

<BaseLayout title={seo.title} description={seo.description} keywords={seo.keywords} route="/business/">
  <section class="page-banner">
      <div class="container">
        <h1>商业资讯</h1>
        <p>行业洞察、就业趋势与职业技能培训前沿观察</p>
        <div class="breadcrumb">
          <a href="/">首页</a> / 商业资讯
        </div>
      </div>
    </section>

    <section class="section news-section">
      <div class="container">
        <div class="section-title">
          <h2>精选资讯</h2>
          <p>解读AI时代职业技能培训趋势，为你的职业决策提供参考</p>
        </div>
        <div class="news-grid">
          {items.map((item) => (
            <article class="news-card">
              <div class="news-image">{item.emoji}</div>
              <div class="news-content">
                <div class="news-date">{item.date}</div>
                <h3>{item.title}</h3>
                <p>{item.summary}</p>
                <a href="#" class="read-more">阅读更多 →</a>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" style="background: var(--bg-light);">
      <div class="container">
        <div class="section-title">
          <h2>行业数据参考</h2>
          <p>基于公开数据与岗位调研，为你的职业选择提供客观参考</p>
        </div>
        <div class="advantage-grid">
          <div class="advantage-card">
            <div class="advantage-icon">📈</div>
            <h3>AI培训市场持续扩大</h3>
            <p>AI相关岗位需求年增长率超过40%，掌握AI工具与岗位结合能力的求职者更具竞争力。</p>
          </div>
          <div class="advantage-card">
            <div class="advantage-icon">🎭</div>
            <h3>短剧市场规模超200亿</h3>
            <p>2026年微短剧市场规模预计达220亿，AI漫剧、AI真人剧等新型内容生产岗位需求快速增长。</p>
          </div>
          <div class="advantage-card">
            <div class="advantage-icon">🌐</div>
            <h3>跨境电商人才缺口大</h3>
            <p>跨境电商企业普遍面临运营人才短缺，具备AI运营能力与真实店铺经验的求职者更受青睐。</p>
          </div>
          <div class="advantage-card">
            <div class="advantage-icon">🎬</div>
            <h3>短视频岗位需求旺盛</h3>
            <p>短视频剪辑、运营、信息流广告等岗位需求持续旺盛，优秀作品集是求职核心竞争力。</p>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="container">
        <h2>把握行业趋势，提升岗位竞争力</h2>
        <p>预约1对1职业规划，获取最新岗位数据与学习方案</p>
        <a href="/contact/" class="btn btn-red">获取职业学习规划</a>
      </div>
    </section>
</BaseLayout>
