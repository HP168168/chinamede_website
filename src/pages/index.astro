---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCampuses, getCourses, getSeoFor, getSiteConfig, groupCampusesByCity } from '../lib/strapi';

const [seo, site, campuses, courses] = await Promise.all([
  getSeoFor('/'),
  getSiteConfig(),
  getCampuses(),
  getCourses(),
]);

// 全国直营校区布局：按城市聚合，点进去跳到联系页对应城市筛选
const campusCityGroups = groupCampusesByCity(campuses, site.cities);

/**
 * 首页精品卡片跳课程详情页的链接。
 * 详情页路由标识取课程的 slug（后台没填 slug 时回退到 code，见 lib/strapi 的 getCourses），
 * 这里从数据里取而不是写死，避免后台改了标识后整批卡片变成 404。
 */
const courseHref = (code: string) => {
  const matched = courses.find((course) => course.code === code);
  if (!matched?.slug) {
    console.warn(`[index] 首页卡片 ${code} 未匹配到课程数据，链接回退为 code`);
  }
  return `/courses/${matched?.slug ?? code}/`;
};
