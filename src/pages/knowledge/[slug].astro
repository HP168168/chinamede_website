---
// 知识百科指南动态路由：/knowledge/<slug>/
// 正文为后台维护的 HTML 片段（含表格与引用块），构建期直接取出渲染，保证与迁移前逐字一致
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getGuides } from '../../lib/strapi';

// getStaticPaths 由 Astro 提升到独立作用域，无法读取 frontmatter 里的变量，
// 因此这里再取一次；取数层有模块级缓存，同一次构建不会产生第二次请求。
export async function getStaticPaths() {
  const guides = await getGuides();
  return guides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const route = `/knowledge/${guide.slug}/`;
const body = guide.content;
---

<BaseLayout title={guide.seo.title} description={guide.seo.description} keywords={guide.seo.keywords} route={route}>
  <section class="page-banner">
    <div class="container">
      <h1>{guide.title}</h1>
      <p>{guide.subtitle}</p>
      <div class="breadcrumb">
        <a href="/">首页</a>{' / '}<a href="/knowledge/">知识百科</a>{' / '}{guide.title}
      </div>
    </div>
  </section>

  <Fragment set:html={body} />
</BaseLayout>
