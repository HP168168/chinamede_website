---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageSeo } from '../../data/pageSeo';

const seo = pageSeo['/teachers/'];
---

<BaseLayout title={seo.title} description={seo.description} keywords={seo.keywords} route="/teachers/">
  <section class="page-banner">
      <div class="container">
        <h1>师资团队</h1>
        <p>一线企业实战派讲师，三师制全程陪伴教学</p>
        <div class="breadcrumb">
          <a href="/">首页</a> / 师资团队
        </div>
      </div>
    </section>

    <section class="section" style="background: #fff;">
      <div class="container">
        <div class="about-grid">
          <div class="about-content">
            <span class="tag">师资理念</span>
            <h2>拒绝纯学院派，只教能上岗的真本事</h2>
            <p>美迪时代教育的教研师资团队均来自一线企业，具备真实岗位实操经验。我们建立讲师分级、课标统一、数据监控、产值挂钩的教学质量管理闭环，确保每一位讲师都能将企业真实工作方法带入课堂。</p>
            <p>通过"三师制"——班主任负责学习跟进、授课老师负责技能交付、就业老师负责岗位对接——为学员提供从入学到就业的全流程陪伴。</p>
            <ul class="about-features">
              <li>讲师均来自一线企业实战岗位</li>
              <li>统一课标与作业评分量表</li>
              <li>模块期评与教学质量数据监控</li>
              <li>企业导师参与商业项目点评</li>
            </ul>
          </div>
          <div class="about-image">
            <div class="about-image-main photo-card">
              <img width="750" height="341" src="/images/advantage_services_tab5.webp" alt="美迪时代教育300+专业服务团队" class="teacher-team-img" loading="lazy" decoding="async" />
            </div>
            <div class="about-badge">
              <div class="num">300+</div>
              <div class="text">专业服务团队</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section teachers-section">
      <div class="container">
        <div class="section-title">
          <h2>核心讲师团队</h2>
          <p>每位讲师都具备丰富的企业项目经验与教学沉淀</p>
        </div>
        <div class="teacher-grid">
          <div class="teacher-card">
            <div class="teacher-avatar">👨‍💼</div>
            <div class="teacher-info">
              <h3>张明远</h3>
              <div class="title">AI新媒体运营学科带头人</div>
              <p>10年新媒体运营与获客经验，曾操盘多个百万级账号，擅长抖音、小红书、视频号全平台运营与企业GEO获客实战。</p>
            </div>
          </div>
          <div class="teacher-card">
            <div class="teacher-avatar">👩‍🎨</div>
            <div class="teacher-info">
              <h3>李思琪</h3>
              <div class="title">AI视觉设计金牌讲师</div>
              <p>8年电商视觉设计经验，服务过多个知名电商品牌，精通C4D、PS精修、AIGC商业出图与品牌IP延展设计。</p>
            </div>
          </div>
          <div class="teacher-card">
            <div class="teacher-avatar">👨‍🎬</div>
            <div class="teacher-info">
              <h3>王浩然</h3>
              <div class="title">商业短视频创作负责人</div>
              <p>前MCN内容总监，主导过数百条商业短视频项目，擅长拍摄剪辑、特效合成、信息流广告与商单履约全流程。</p>
            </div>
          </div>
          <div class="teacher-card">
            <div class="teacher-avatar">👩‍💻</div>
            <div class="teacher-info">
              <h3>陈雨桐</h3>
              <div class="title">AIGC全能班主讲</div>
              <p>深耕AI工具应用与智能体开发，熟悉Coze、Dify等平台，擅长将AI能力落地到运营、设计、视频等真实工作场景。</p>
            </div>
          </div>
          <div class="teacher-card">
            <div class="teacher-avatar">👨‍🎭</div>
            <div class="teacher-info">
              <h3>刘子轩</h3>
              <div class="title">AI短剧漫剧创作导师</div>
              <p>参与多部短剧/漫剧项目制作，熟悉AI漫剧、AI真人剧全流程，掌握短剧备案合规、投流分账与平台征稿通道。</p>
            </div>
          </div>
          <div class="teacher-card">
            <div class="teacher-avatar">👩‍🌐</div>
            <div class="teacher-info">
              <h3>赵雅琳</h3>
              <div class="title">跨境电商实战讲师</div>
              <p>10年跨境电商运营经验，操盘过亚马逊、TikTok、独立站等多平台项目，擅长海外社媒运营与Facebook高阶投流。</p>
            </div>
          </div>
          <div class="teacher-card">
            <div class="teacher-avatar">👨‍💼</div>
            <div class="teacher-info">
              <h3>周建国</h3>
              <div class="title">就业指导总监</div>
              <p>负责学员就业服务体系建设，对接全国合作企业资源，擅长简历诊断、模拟面试、岗位匹配与职场发展规划。</p>
            </div>
          </div>
          <div class="teacher-card">
            <div class="teacher-avatar">👩‍🏫</div>
            <div class="teacher-info">
              <h3>吴文静</h3>
              <div class="title">教学督导负责人</div>
              <p>负责教学质量监控与讲师评级，通过随堂听课、学员期评、模块通过率等数据，持续优化教学标准与服务体验。</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" style="background: #fff;">
      <div class="container">
        <div class="section-title">
          <h2>讲师评级体系</h2>
          <p>分级考核、数据驱动，确保教学质量稳定可控</p>
        </div>
        <div class="course-grid">
          <div class="course-card">
            <div class="course-image" style="background: linear-gradient(135deg, #0066FF, #5B9AFF);">L1</div>
            <div class="course-info">
              <h3>L1 助理讲师</h3>
              <p>通过模块知识笔试与助教实习，承担答疑、批改、助教课等基础教学工作。</p>
              <div class="course-meta">
                <span>📝 模块笔试</span>
                <span>👨‍🏫 助教实习</span>
              </div>
            </div>
          </div>
          <div class="course-card">
            <div class="course-image" style="background: linear-gradient(135deg, #7B2FF7, #B07CFF);">L2</div>
            <div class="course-info">
              <h3>L2 认证讲师</h3>
              <p>试讲双评≥80分，项目实操考核通过，可独立承担单模块授课与标准课时。</p>
              <div class="course-meta">
                <span>🎤 试讲考核</span>
                <span>🛠️ 项目实操</span>
              </div>
            </div>
          </div>
          <div class="course-card">
            <div class="course-image" style="background: linear-gradient(135deg, #E60012, #FF4D5A);">L3</div>
            <div class="course-info">
              <h3>L3 资深讲师</h3>
              <p>满两年且学员期评≥4.5，主导课纲迭代，享受学科分红与讲师带教职责。</p>
              <div class="course-meta">
                <span>⭐ 期评≥4.5</span>
                <span>📚 课纲迭代</span>
              </div>
            </div>
          </div>
          <div class="course-card">
            <div class="course-image" style="background: linear-gradient(135deg, #006D77, #83C5BE);">M</div>
            <div class="course-info">
              <h3>M 企业导师</h3>
              <p>行业在职专家，参与商业项目点评、前沿模块教学与岗位标准输入。</p>
              <div class="course-meta">
                <span>💼 一线在职</span>
                <span>🎯 项目点评</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section" style="background: var(--bg-light);">
      <div class="container">
        <div class="section-title">
          <h2>教学质量保障</h2>
          <p>多维度监控，把教学质量变成可量化、可改进的数据系统</p>
        </div>
        <div class="advantage-grid">
          <div class="advantage-card">
            <div class="advantage-icon">📊</div>
            <h3>期评满意度</h3>
            <p>每模块结束匿名评分，低于4.0触发教研介入，连续两期低于4.0讲师降级。</p>
          </div>
          <div class="advantage-card">
            <div class="advantage-icon">📝</div>
            <h3>模块通过率</h3>
            <p>统一作业标准答案与评分量表，模块结业测验通过率纳入讲师考核。</p>
          </div>
          <div class="advantage-card">
            <div class="advantage-icon">🎧</div>
            <h3>督导随堂听课</h3>
            <p>总部教学督导每周随机进班听课≥2次，6大校区全覆盖月度轮巡。</p>
          </div>
          <div class="advantage-card">
            <div class="advantage-icon">💼</div>
            <h3>就业表现反推</h3>
            <p>所带学员就业岗位胜任度回访，就业率最低的模块优先迭代。</p>
          </div>
          <div class="advantage-card">
            <div class="advantage-icon">📹</div>
            <h3>名师直播同步</h3>
            <p>总部名师直播+校区助教面辅，保证6大校区课标与名师资源同步。</p>
          </div>
          <div class="advantage-card">
            <div class="advantage-icon">🌐</div>
            <h3>线上实训系统</h3>
            <p>建设/采购浏览器内实操实训系统，提升练习完成率与异地一致性。</p>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="container">
        <h2>加入美迪时代讲师团队</h2>
        <p>如果你是行业实战派，愿意把一线经验传授给更多转行求职者，欢迎投递简历</p>
        <a href="/contact/" class="btn btn-red">讲师应聘咨询</a>
      </div>
    </section>
</BaseLayout>
