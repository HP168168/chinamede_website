---
import type { Teacher } from '../../types/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  DEFAULT_TEACHER_PHOTO,
  getSeoFor,
  getTeacherLevels,
  getTeachers,
  groupTeachersByLevel,
} from '../../lib/strapi';

const [seo, teachers, teacherLevels] = await Promise.all([
  getSeoFor('/teachers/'),
  getTeachers(),
  getTeacherLevels(),
]);

// 展示顺序：按后台「师资层级」的先后聚合讲师，同一层级内保持后台 order 升序
const teachersOrdered = groupTeachersByLevel(teachers, teacherLevels).flatMap((group) => group.teachers);

/**
 * 层级标签：直接取关联关系带来的层级名称（「师资层级」主表的 name），
 * 关系缺失时退回历史编码，两者都没有则不渲染标签
 */
const levelLabel = (teacher: Teacher) => teacher.levelName || teacher.levelCode;
---

<BaseLayout title={seo.title} description={seo.description} keywords={seo.keywords} route="/teachers/">
  <section class="page-banner">
      <div class="container">
        <h1>师资团队</h1>
        <p>一线企业实战派讲师，三师制全程陪伴教学</p>
        <div class="breadcrumb">
          <a href="/">首页</a> / 师资团队
        </div>
      </div>
    </section>

    <section class="section" style="background: #fff;">
      <div class="container">
        <div class="about-grid">
          <div class="about-content">
            <span class="tag">师资理念</span>
            <h2>拒绝纯学院派，只教能上岗的真本事</h2>
            <p>美迪时代教育的教研师资团队均来自一线企业，具备真实岗位实操经验。我们建立讲师分级、课标统一、数据监控、产值挂钩的教学质量管理闭环，确保每一位讲师都能将企业真实工作方法带入课堂。</p>
            <p>通过"三师制"——班主任负责学习跟进、授课老师负责技能交付、就业老师负责岗位对接——为学员提供从入学到就业的全流程陪伴。</p>
            <ul class="about-features">
              <li>讲师均来自一线企业实战岗位</li>
              <li>统一课标与作业评分量表</li>
              <li>模块期评与教学质量数据监控</li>
              <li>企业导师参与商业项目点评</li>
            </ul>
          </div>
          <div class="about-image">
            <div class="about-image-main photo-card">
              <img width="750" height="341" src="/images/advantage_services_tab5.webp" alt="美迪时代教育300+专业服务团队" class="teacher-team-img" loading="lazy" decoding="async" />
            </div>
            <div class="about-badge">
              <div class="num">300+</div>
              <div class="text">专业服务团队</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section teachers-section">
      <div class="container">
        <div class="section-title">
          <h2>核心讲师团队</h2>
          <p>每位讲师都具备丰富的企业项目经验与教学沉淀</p>
        </div>
        {teachersOrdered.length > 0 ? (
          <div class="teacher-grid">
            {teachersOrdered.map((teacher) => (
              <div class="teacher-card">
                <div class="teacher-avatar">
                  <img
                    src={teacher.photo}
                    alt={
                      teacher.photo === DEFAULT_TEACHER_PHOTO
                        ? `${teacher.name}（暂无形象照）`
                        : `${teacher.name}形象照`
                    }
                    width="120"
                    height="120"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
                <div class="teacher-info">
                  <h3>{teacher.name}</h3>
                  <div class="title">{teacher.title}</div>
                  {levelLabel(teacher) && (
                    <div class="course-meta" style="justify-content: center; margin-bottom: 8px;">
                      <span class="tag">{levelLabel(teacher)}</span>
                    </div>
                  )}
                  <p>{teacher.desc}</p>
                </div>
              </div>
            ))}
          </div>
        ) : (
          <p style="text-align: center; color: var(--text-gray);">
            讲师档案正在整理中，可先了解各课程对应的授课师资安排。
          </p>
        )}
      </div>
    </section>

    <section class="section" style="background: #fff;">
      <div class="container">
        <div class="section-title">
          <h2>讲师评级体系</h2>
          <p>分级考核、数据驱动，确保教学质量稳定可控</p>
        </div>
        <div class="course-grid">
          {teacherLevels.map((level) => (
            <div class="course-card">
              <div class="course-image" style={level.gradient}>{level.code}</div>
              <div class="course-info">
                <h3>{level.name}</h3>
                <p>{level.desc}</p>
                <div class="course-meta">
                  {level.meta.map((item) => <span>{item}</span>)}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section" style="background: var(--bg-light);">
      <div class="container">
        <div class="section-title">
          <h2>教学质量保障</h2>
          <p>多维度监控，把教学质量变成可量化、可改进的数据系统</p>
        </div>
        <div class="advantage-grid">
          <div class="advantage-card">
            <div class="advantage-icon">📊</div>
            <h3>期评满意度</h3>
            <p>每模块结束匿名评分，低于4.0触发教研介入，连续两期低于4.0讲师降级。</p>
          </div>
          <div class="advantage-card">
            <div class="advantage-icon">📝</div>
            <h3>模块通过率</h3>
            <p>统一作业标准答案与评分量表，模块结业测验通过率纳入讲师考核。</p>
          </div>
          <div class="advantage-card">
            <div class="advantage-icon">🎧</div>
            <h3>督导随堂听课</h3>
            <p>总部教学督导每周随机进班听课≥2次，6大校区全覆盖月度轮巡。</p>
          </div>
          <div class="advantage-card">
            <div class="advantage-icon">💼</div>
            <h3>就业表现反推</h3>
            <p>所带学员就业岗位胜任度回访，就业率最低的模块优先迭代。</p>
          </div>
          <div class="advantage-card">
            <div class="advantage-icon">📹</div>
            <h3>名师直播同步</h3>
            <p>总部名师直播+校区助教面辅，保证6大校区课标与名师资源同步。</p>
          </div>
          <div class="advantage-card">
            <div class="advantage-icon">🌐</div>
            <h3>线上实训系统</h3>
            <p>建设/采购浏览器内实操实训系统，提升练习完成率与异地一致性。</p>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="container">
        <h2>加入美迪时代讲师团队</h2>
        <p>如果你是行业实战派，愿意把一线经验传授给更多转行求职者，欢迎投递简历</p>
        <a href="/contact/" class="btn btn-red">讲师应聘咨询</a>
      </div>
    </section>
</BaseLayout>
