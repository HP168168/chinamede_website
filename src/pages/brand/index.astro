---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getSeoFor } from '../../lib/strapi';

const seo = await getSeoFor('/brand/');
---

<BaseLayout title={seo.title} description={seo.description} keywords={seo.keywords} route="/brand/">
  <section class="page-banner">
      <div class="container">
        <h1>品牌介绍</h1>
        <p>了解美迪时代教育的品牌故事、企业使命与核心价值观</p>
        <div class="breadcrumb">
          <a href="/">首页</a> / 品牌介绍
        </div>
      </div>
    </section>

    <section class="section brand-story">
      <div class="container">
        <div class="section-title">
          <h2>品牌故事</h2>
          <p>从2011年出发，美迪时代教育始终专注成人职业技能就业培训</p>
        </div>
        <div class="story-grid">
          <div class="story-column">
            <div class="story-card">
              <h3><span class="icon icon-logo"><img width="100" height="100" src="/images/logo_original.png" alt="美迪时代教育LOGO" loading="lazy" decoding="async" /></span>品牌背景</h3>
              <p>
                美迪时代教育隶属于广州美迪教育科技有限公司，是集团旗下专注成人职业技能就业培训的核心品牌，集团同时运营电商创业培训品牌美迪电商教育。自2011年成立以来，始终致力于成为广大成人学习者与用人企业可信赖的职业成长伙伴。
              </p>
            </div>
            <div class="story-card">
              <h3><span class="icon">🎯</span>品牌定位</h3>
              <p>
                作为国内少数具备全链路数字化职业人才培养能力的综合服务商，我们依托自主研发岗位实战课程体系与300余人专业服务团队，构建涵盖职业教育、在线教育、职业考证、学历提升、人才对接、项目实训、就业帮扶的一站式职业人才培养解决方案。
              </p>
            </div>
            <div class="story-card">
              <h3><span class="icon">🌟</span>品牌使命</h3>
              <p>美迪时代教育致力于帮助职场人、转行求职者打通技能学习到上岗就业的完整路径，同时为企业输送适配岗位需求的实战型技能人才。我们坚持"让职业就业更简单"的品牌使命，让每位学员都能学有所成、学以致用、顺利上岗。</p>
            </div>
          </div>
          <div class="story-column">
            <div class="story-card">
              <h3><span class="icon">🗺️</span>全国布局</h3>
              <p>
                深耕线下，线上辅助，布局全国。现已在广州、深圳、佛山、东莞、中山、江门等粤港澳大湾区核心城市开设6城13个直营校区，凭借本地化教学与属地企业就业资源，就近服务学员，打通学习-实训-本地就业全链路。
              </p>
            </div>
            <div class="story-card">
              <h3><span class="icon">📚</span>课程体系</h3>
              <p>
                紧跟当下职场发展趋势与行业就业风口，我们深耕热门高薪就业赛道，打造多领域系统化就业课程体系，涵盖AIGC应用、AI新媒体运营、AI设计师、商业短视频、短剧漫剧、亚马逊、TikTok、海外社媒运营等数十门精品就业课程。
              </p>
            </div>
            <div class="story-card">
              <h3><span class="icon">💪</span>我们的承诺</h3>
              <p>我们拒绝空洞的理论教学，摒弃纸上谈兵的授课模式，坚持以职场真实岗位逻辑、落地实战项目案例为核心，为广大学员提供专业、高效的职业技能培训与就业帮扶服务，真正践行"让职业就业更简单"的品牌使命。</p>
