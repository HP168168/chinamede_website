---
// 文章列表分页页：/articles/page/2/、/articles/page/3/ ...
// 第一页固定在 /articles/，这里只生成第 2 页及以后，避免同一内容两个地址
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { getArticles, getSeoFor, getSiteConfig } from '../../../lib/strapi';
import { sliceArticles, totalArticlePages } from '../../../lib/articles';

// getStaticPaths 由 Astro 提升到独立作用域，无法读取 frontmatter 变量，这里重新取数（有模块级缓存）
export async function getStaticPaths() {
  const articles = await getArticles();
  const totalPages = totalArticlePages(articles.length);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const pageNumber = index + 2;
    return {
      params: { page: String(pageNumber) },
      props: {
        pageNumber,
        totalPages,
        totalCount: articles.length,
        items: sliceArticles(articles, pageNumber),
      },
    };
  });
}

const { pageNumber, totalPages, totalCount, items } = Astro.props;
const [seo, site] = await Promise.all([getSeoFor('/articles/'), getSiteConfig()]);

const route = `/articles/page/${pageNumber}/`;
const title = `${seo.title.replace(/ - 美迪时代教育$/, '')}_第${pageNumber}页 - 美迪时代教育`;
---

<BaseLayout title={title} description={seo.description} keywords={seo.keywords} route={route}>
  <section class="page-banner">
      <div class="container">
        <h1>精选文章</h1>
        <p>第 {pageNumber} 页 · 共 {totalPages} 页</p>
        <div class="breadcrumb">
          <a href="/">首页</a> / <a href="/articles/">精选文章</a> / 第 {pageNumber} 页
        </div>
      </div>
    </section>

    <section class="section news-section">
      <div class="container">
        <div class="section-title">
          <h2>最新文章</h2>
          <p>共 {totalCount} 篇，按发布时间倒序</p>
        </div>

        <div class="news-grid">
          {items.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>

        <nav class="pager" aria-label="文章分页">
          <a class="pager-link" href={pageNumber === 2 ? '/articles/' : `/articles/page/${pageNumber - 1}/`}>← 上一页</a>
          <span class="pager-status">第 {pageNumber} / {totalPages} 页</span>
          {pageNumber < totalPages ? <a class="pager-link" href={`/articles/page/${pageNumber + 1}/`}>下一页 →</a> : <span class="pager-link is-disabled">下一页 →</span>}
        </nav>
      </div>
    </section>

    <section class="cta-section">
      <div class="container">
        <h2>想系统学习，而不只是看文章？</h2>
        <p>预约免费试听，由课程顾问为你做职业能力诊断与学习路径规划。咨询热线{site.telephone}（每天{site.serviceHours}）</p>
        <a href="/enroll/" class="btn btn-red">免费预约试听</a>
      </div>
    </section>

</BaseLayout>
