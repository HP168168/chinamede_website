---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import { getFaqs, getSeoFor, getSiteConfig } from '../../lib/strapi';

const [seo, site, faqs] = await Promise.all([getSeoFor('/faq/'), getSiteConfig(), getFaqs()]);
---

<BaseLayout title={seo.title} description={seo.description} keywords={seo.keywords} route="/faq/">
  <section class="page-banner">
      <div class="container">
        <h1>美迪问答</h1>
        <p>关于课程、就业、学费、校区的常见问题解答</p>
        <div class="breadcrumb">
          <a href="/">首页</a> / 美迪问答
        </div>
      </div>
    </section>

    <FaqAccordion
      items={faqs}
      title="常见问题"
      subtitle={`如果以下没有解答您的疑问，欢迎拨打${site.telephone}或微信扫码咨询课程顾问`}
      sectionClass="faq-section"
    />

    <section class="cta-section">
      <div class="container">
        <h2>还有其他问题？</h2>
        <p>留下您的联系方式，课程顾问将在2小时内为您解答，并提供专属学习规划</p>
        <a href="/contact/" class="btn btn-red">立即咨询</a>
      </div>
    </section>
</BaseLayout>
