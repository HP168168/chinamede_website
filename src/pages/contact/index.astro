---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCampuses, getSeoFor, getSiteConfig, groupCampusesByCity } from '../../lib/strapi';

// 页面全部联系方式（二维码、客服手机号、热线、服务时间、公司主体）与校区卡片均来自后台
const [seo, site, campuses] = await Promise.all([getSeoFor('/contact/'), getSiteConfig(), getCampuses()]);

// 城市筛选标签顺序取站点设置的城市顺序，组内保持后台排序
const cityGroups = groupCampusesByCity(campuses, site.cities);

/** 交通图标：有地铁线路用 🚇，仅公交到达用 🚌（与迁移前页面一致） */
const trafficIcon = (text: string) => (text.includes('地铁') ? '🚇' : '🚌');

/** 站点域名（用于「官方网站」一行），改域名无需改代码 */
const siteHost = site.url.replace(/^https?:\/\//, '').replace(/\/.*$/, '');

/** 服务时间紧凑写法：8:00-23:00（与迁移前联系页文案一致） */
const serviceHoursCompact = site.serviceHours.replace(/\s/g, '');
---

<BaseLayout title={seo.title} description={seo.description} keywords={seo.keywords} route="/contact/">
  <section class="page-banner">
      <div class="container">
        <h1>联系我们</h1>
        <p>全国{site.campusDisplay}，期待与你面对面沟通职业规划</p>
        <div class="breadcrumb">
          <a href="/">首页</a> / 联系我们
        </div>
      </div>
    </section>

    <section class="section contact-section">
      <div class="container">
        <div class="contact-grid">
          <div class="contact-wechat-card" id="wechat">
            <div class="wechat-card-header">
              <h2>扫码添加课程顾问</h2>
              <p>{site.wechatScanTip}</p>
              <span class="wechat-badge">官方微信 · 顾问直通</span>
            </div>
            <div class="wechat-qr-wrapper">
              <div class="qr-img-box">
                <img width="357" height="355" src={site.wechatQr} alt={site.wechatQrAlt} class="wechat-qr-img" loading="lazy" decoding="async" />
              </div>

              <div class="wechat-phone-action">
                <div class="phone-action-label">
                  <span class="pulse-dot"></span>
                  <span>{site.wechatPhoneLabel}</span>
                </div>
                <a href={`tel:${site.wechatPhone}`} class="phone-action-btn" title={`点击呼叫 ${site.wechatPhone} 或微信搜索添加`}>
                  <span class="action-icon">📞</span>
                  <span class="action-num">{site.wechatPhone}</span>
                  <span class="action-tag">点击拨打 / 加微信</span>
                </a>
              </div>

              <div class="qr-scan-tips">
                <div class="scan-tip-item">
                  <span class="tip-icon">💬</span>
                  <span>微信搜索手机号 <strong>{site.wechatPhone}</strong> 添加好友</span>
                </div>
                <div class="scan-tip-item">
                  <span class="tip-icon">🎁</span>
                  <span>免费领取最新课表与实战资料包</span>
                </div>
                <div class="scan-tip-item">
                  <span class="tip-icon">⚡</span>
                  <span>1对1定制职业学习与转行规划</span>
                </div>
              </div>
            </div>
          </div>

          <div class="contact-info-card">
            <h2>与我们取得联系</h2>
            <p>无论您是咨询课程、洽谈合作，还是应聘讲师，都可以通过以下方式联系美迪时代教育。</p>

            <div class="contact-info-list">
              <div class="contact-item">
                <div class="icon">📞</div>
                <div>
                  <h4>咨询热线</h4>
                  <p>{site.telephone}（工作日 {serviceHoursCompact}）</p>
                </div>
              </div>

              <div class="contact-item">
                <div class="icon">🌐</div>
                <div>
                  <h4>官方网站</h4>
                  <p>{siteHost}</p>
                </div>
              </div>

              <div class="contact-item">
                <div class="icon">🏢</div>
                <div>
                  <h4>公司主体</h4>
                  <p>{site.legalName}</p>
                </div>
              </div>

              <div class="contact-item">
                <div class="icon">⏰</div>
                <div>
                  <h4>咨询响应</h4>
                  <p>咨询线索首次响应 ≤ 2小时</p>
                </div>
              </div>

              <div class="contact-item">
                <div class="icon">🤝</div>
                <div>
                  <h4>合作咨询</h4>
                  <p>高校合作、企业团培、人才定制、讲师应聘</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section campus-section" style="background: #fff;">
      <div class="container">
        <div class="section-title">
          <h2>全国校区分布</h2>
          <p>{site.cities.join('、')} {site.cities.length} 城 {site.campusCount} 个直营校区，欢迎就近到校参观试听</p>
        </div>

        <div class="campus-tabs" role="tablist" aria-label="按城市筛选校区">
          <button type="button" class="campus-tab active" role="tab" aria-selected="true" data-city="all">全部校区 {campuses.length}</button>
          {cityGroups.map((group) => (
            <button type="button" class="campus-tab" role="tab" aria-selected="false" data-city={group.cityCode}>
              {group.city}校区 {group.campuses.length}
            </button>
          ))}
        </div>

        <div class="campus-card-list">
          {cityGroups.map((group) =>
            group.campuses.map((campus) => (
              <article class="campus-card" id={campus.id} data-city={campus.cityCode}>
                <div class="campus-card-media">
                  <img src={campus.cover.src} alt={campus.cover.alt}
                    width={campus.cover.width} height={campus.cover.height} loading="lazy" decoding="async">
                </div>
                <div class="campus-card-body">
                  <h3 class="campus-card-title">{campus.displayTitle}</h3>
                  <ul class="campus-card-meta">
                    <li><span class="meta-icon">📍</span><span><strong>校区联系地址：</strong>{campus.streetAddress}</span></li>
                    <li><span class="meta-icon">📞</span><span><strong>全国官方热线：</strong><a href={site.telephoneHref}>{site.telephone}</a></span></li>
                    <li><span class="meta-icon">☎️</span><span><strong>校区官方电话：</strong><a href={`tel:${campus.telephone}`}>{campus.telephone}</a></span></li>
                    <li><span class="meta-icon">{trafficIcon(campus.trafficDisplay)}</span><span><strong>交通指引：</strong>{campus.trafficDisplay}</span></li>
                  </ul>
                  <div class="campus-card-actions">
                    <a href="/enroll/" class="campus-btn campus-btn-ghost">预约免费试听</a>
                    <a href="#wechat" class="campus-btn campus-btn-primary">在线咨询</a>
                    <a href={`tel:${campus.telephone}`} class="campus-btn campus-btn-call">拨打校区电话</a>
                  </div>
                </div>
              </article>
            )),
          )}
        </div>
      </div>
    </section>

    <section class="section" style="background: var(--bg-light);">
      <div class="container">
        <div class="section-title">
          <h2>服务承诺</h2>
          <p>选择美迪，选择透明、规范、可信赖的职业教育服务</p>
        </div>
        <div class="advantage-grid">
          <div class="advantage-card">
            <div class="advantage-icon">💬</div>
            <h3>2小时响应</h3>
            <p>咨询线索首次响应不超过2小时，学习问题答疑不超过24小时。</p>
          </div>
          <div class="advantage-card">
            <div class="advantage-icon">📋</div>
            <h3>专属学习规划</h3>
            <p>每位咨询学员均可获得《个人学习规划书》，含岗位数据、竞品对比与班型匹配建议。</p>
          </div>
          <div class="advantage-card">
            <div class="advantage-icon">🎧</div>
            <h3>免费试听</h3>
            <p>提供1节正课免费试听，亲身感受教学质量与课堂氛围。</p>
          </div>
          <div class="advantage-card">
            <div class="advantage-icon">🛡️</div>
            <h3>透明退费</h3>
            <p>分段退费公式写入合同，流程节点短信同步，审批不超过15个工作日。</p>
          </div>
        </div>
      </div>
    </section>

    <section class="cta-section">
      <div class="container">
        <h2>期待与你相遇</h2>
        <p>无论你是想转行、提升还是为企业寻找人才，美迪都愿意成为你的职业成长伙伴</p>
        <a href={site.telephoneHref} class="btn btn-red">立即拨打 {site.telephone}</a>
      </div>
    </section>

</BaseLayout>

<script>
  // 校区城市筛选（原 js/main.js 第 5.1 段）
  const campusTabs = document.querySelectorAll<HTMLElement>('.campus-tabs .campus-tab');
  const campusCards = document.querySelectorAll<HTMLElement>('.campus-card');

  if (campusTabs.length && campusCards.length) {
    campusTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const city = tab.getAttribute('data-city');

        campusTabs.forEach((t) => {
          t.classList.remove('active');
          t.setAttribute('aria-selected', 'false');
        });
        tab.classList.add('active');
        tab.setAttribute('aria-selected', 'true');

        campusCards.forEach((card) => {
          const matched = city === 'all' || card.getAttribute('data-city') === city;
          card.style.display = matched ? 'flex' : 'none';
        });
      });
    });

    // 支持首页「全国直营校区布局」跳转：/contact/#city-gz
    const applyCityFromHash = () => {
      const match = /^#city-([a-z]+)$/.exec(window.location.hash);
      if (!match) return;

      const tab = document.querySelector<HTMLElement>(`.campus-tabs .campus-tab[data-city="${match[1]}"]`);
      if (!tab) return;

      tab.click();

      const section = document.querySelector<HTMLElement>('.campus-section');
      if (section) {
        const top = section.getBoundingClientRect().top + window.pageYOffset - 90;
        window.scrollTo({ top, behavior: 'smooth' });
      }
    };

    applyCityFromHash();
    window.addEventListener('hashchange', applyCityFromHash);
  }
</script>
