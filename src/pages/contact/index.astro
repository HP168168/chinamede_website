---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { pageSeo } from '../../data/pageSeo';

const seo = pageSeo['/contact/'];
---

<BaseLayout title={seo.title} description={seo.description} keywords={seo.keywords} route="/contact/">
  <section class="page-banner">
      <div class="container">
        <h1>联系我们</h1>
        <p>全国6城13个直营校区，期待与你面对面沟通职业规划</p>
        <div class="breadcrumb">
          <a href="/">首页</a> / 联系我们
        </div>
      </div>
    </section>

    <section class="section contact-section">
      <div class="container">
        <div class="contact-grid">
          <div class="contact-wechat-card" id="wechat">
            <div class="wechat-card-header">
              <h2>扫码添加课程顾问</h2>
              <p>微信扫一扫二维码，一对一专属课程顾问在线解答</p>
              <span class="wechat-badge">官方微信 · 顾问直通</span>
            </div>
            <div class="wechat-qr-wrapper">
              <div class="qr-img-box">
                <img width="357" height="355" src="/images/wechat_qrcode.png" alt="美迪时代教育课程顾问微信二维码" class="wechat-qr-img" loading="lazy" decoding="async" />
              </div>

              <div class="wechat-phone-action">
                <div class="phone-action-label">
                  <span class="pulse-dot"></span>
                  <span>手机 / 微信同号（支持一键拨打与微信搜索）</span>
                </div>
                <a href="tel:18922386984" class="phone-action-btn" title="点击呼叫 18922386984 或微信搜索添加">
                  <span class="action-icon">📞</span>
                  <span class="action-num">18922386984</span>
                  <span class="action-tag">点击拨打 / 加微信</span>
                </a>
              </div>

              <div class="qr-scan-tips">
                <div class="scan-tip-item">
                  <span class="tip-icon">💬</span>
                  <span>微信搜索手机号 <strong>18922386984</strong> 添加好友</span>
                </div>
                <div class="scan-tip-item">
                  <span class="tip-icon">🎁</span>
                  <span>免费领取最新课表与实战资料包</span>
                </div>
                <div class="scan-tip-item">
                  <span class="tip-icon">⚡</span>
                  <span>1对1定制职业学习与转行规划</span>
                </div>
              </div>
            </div>
          </div>

          <div class="contact-info-card">
            <h2>与我们取得联系</h2>
            <p>无论您是咨询课程、洽谈合作，还是应聘讲师，都可以通过以下方式联系美迪时代教育。</p>

            <div class="contact-info-list">
              <div class="contact-item">
                <div class="icon">📞</div>
                <div>
                  <h4>咨询热线</h4>
                  <p>400-800-4459（工作日 8:00-23:00）</p>
                </div>
              </div>

              <div class="contact-item">
                <div class="icon">🌐</div>
                <div>
                  <h4>官方网站</h4>
                  <p>www.chinamede.com</p>
                </div>
              </div>

              <div class="contact-item">
                <div class="icon">🏢</div>
                <div>
                  <h4>公司主体</h4>
                  <p>广州美迪教育科技有限公司</p>
                </div>
              </div>

              <div class="contact-item">
                <div class="icon">⏰</div>
                <div>
                  <h4>咨询响应</h4>
                  <p>咨询线索首次响应 ≤ 2小时</p>
                </div>
              </div>

              <div class="contact-item">
                <div class="icon">🤝</div>
                <div>
                  <h4>合作咨询</h4>
                  <p>高校合作、企业团培、人才定制、讲师应聘</p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

