---
// 页面底部招生 CTA 区块（原各页面 cta-section）
interface Props {
  title: string;
  text: string;
  btnText?: string;
  href?: string;
}

const { title, text, btnText = '免费预约试听', href = '/enroll/' } = Astro.props;
---

<section class="cta-section">
  <div class="container">
    <h2>{title}</h2>
    <p>{text}</p>
    <a href={href} class="btn btn-red">{btnText}</a>
  </div>
</section>
