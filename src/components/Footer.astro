---
// 页脚
// variant:
//   default - 品牌区 + 链接组 + 联系方式 + 备案信息（普通页面）
//   simple  - 仅备案信息（404 页面沿用旧站结构）
import { getNavigation, getSiteConfig } from '../lib/strapi';

interface Props {
  variant?: 'default' | 'simple';
}

const { variant = 'default' } = Astro.props;

const [site, navigation] = await Promise.all([getSiteConfig(), getNavigation()]);
const { footerGroups, footerIntro, footerContacts, footerBottom } = navigation;

/**
 * 页脚底部的备案信息：文案由后台维护，若其中出现备案号，则自动把该段渲染成工信部链接。
 * 号码与链接地址同样来自后台「站点设置」，改号无需改代码。
 */
const bottomLines = footerBottom.map((line) => {
  const index = site.icp ? line.indexOf(site.icp) : -1;
  return index === -1
    ? { before: line, icp: '', after: '' }
    : { before: line.slice(0, index), icp: site.icp, after: line.slice(index + site.icp.length) };
});
---

<footer class="footer">
  <div class="container">
    {
      variant === 'default' ? (
        <>
          <div class="footer-grid">
            <div class="footer-brand">
              <a href="/" class="logo">
                <img width="2125" height="505" src={site.logo} alt={site.logoAlt} class="logo-img" />
              </a>
              <p>{footerIntro}</p>
            </div>
            {footerGroups.map((group) => (
              <div class="footer-links">
                <h4 class="footer-title">{group.title}</h4>
                <ul>
                  {group.links.map((link) => (
                    <li>
                      <a href={link.href}>{link.label}</a>
                    </li>
                  ))}
                </ul>
              </div>
            ))}
            <div class="footer-contact">
              <h4 class="footer-title">联系我们</h4>
              {footerContacts.map((line) => <p>{line}</p>)}
            </div>
          </div>
          <div class="footer-bottom">
            {bottomLines.map((line) => (
              <p>
                {line.before}
                {line.icp !== '' && (
                  <a href={site.icpUrl} class="beian" target="_blank" rel="noopener">
                    {line.icp}
                  </a>
                )}
                {line.after}
              </p>
            ))}
          </div>
        </>
      ) : (
        <div class="footer-bottom" style="border:none;padding-top:0;">
          {bottomLines.map((line) => (
            <p>
              {line.before}
              {line.icp !== '' && (
                <a href={site.icpUrl} class="beian" target="_blank" rel="noopener">
                  {line.icp}
                </a>
              )}
              {line.after}
            </p>
          ))}
        </div>
      )
    }
  </div>
</footer>
