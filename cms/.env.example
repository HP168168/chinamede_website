# ============================================================================
# 美迪时代教育 内容后台（Strapi 5）环境变量示例
# 复制为 .env 后按需修改；.env 不进入版本库。
# ============================================================================

# ---------- 服务 ----------
HOST=0.0.0.0
PORT=1337
# 后台对外访问地址（生产环境改成实际域名，例如 https://cms.chinamede.com）
PUBLIC_URL=http://localhost:1337
# 生产环境是否允许跨域携带 Cookie（官网构建机在别的域名时按需开启）
WEBHOOKS_POPULATE_RELATIONS=false

# ---------- 安全密钥（安装后请全部替换为随机值）----------
APP_KEYS=toBeModified1,toBeModified2
API_TOKEN_SALT=toBeModified
ADMIN_JWT_SECRET=toBeModified
TRANSFER_TOKEN_SALT=toBeModified
ENCRYPTION_KEY=toBeModified
JWT_SECRET=toBeModified

# ---------- 数据库 ----------
# sqlite（默认，零配置）/ mysql / postgres
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db
# 切换到 MySQL 时填以下项
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=meidi_cms
DATABASE_USERNAME=root
DATABASE_PASSWORD=
DATABASE_SSL=false

# ---------- 官网对接 ----------
# 官网地址（生成绝对链接、canonical、llms.txt 使用）
PUBLIC_SITE_URL=https://www.chinamede.com
# 只读 API Token：在后台 Settings → API Tokens 创建后填入
# 官网构建（astro build）与快照导出脚本使用
STRAPI_URL=http://localhost:1337
STRAPI_READONLY_TOKEN=
# 写入 API Token：内容工厂（npm run ai:run）写回草稿与任务状态使用，需 Full access
STRAPI_WRITE_TOKEN=
# 内容发布后触发官网重建的 Webhook（GitHub repository_dispatch）
DEPLOY_WEBHOOK_URL=
DEPLOY_WEBHOOK_TOKEN=

# ---------- AI 内容工厂 ----------
# 目前仅实现 openai 兼容协议；DeepSeek / 通义千问 / OpenAI 均可用，只换 Base URL 与模型名
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat
AI_API_KEY=
# 单次运行最多生成篇数（防止误触发耗尽额度）
AI_DAILY_LIMIT=3
# 单篇生成失败重试次数上限
AI_MAX_RETRIES=2
# 请求超时（毫秒）
AI_TIMEOUT_MS=120000
# 批量生成的时间窗口，如 09:00-21:00；留空表示不限（单篇手动执行不受限制）
AI_RUN_WINDOW=
# ---------- 知识检索（RAG）----------
# 检索实现：
#   keyword  关键词/标签打分（默认，零依赖零成本，始终可用）
#   hybrid   向量 + 关键词融合（推荐；向量不可用时自动退回 keyword）
#   vector   纯向量检索
#   remote   调用外部知识库（见下方 EXTERNAL_KB_ENDPOINT）
KB_RETRIEVER=keyword
# 向量库文件路径（SQLite），默认 cms/.tmp/kb-vectors.db
KB_VECTOR_DB=
# 后台保存/发布知识条目时自动索引该条（true/false）
KB_AUTO_INDEX=true

# 向量化服务（OpenAI 兼容协议的 /embeddings 接口）
# 通义千问：https://dashscope.aliyuncs.com/compatible-mode/v1 + text-embedding-v3
# 智谱：    https://open.bigmodel.cn/api/paas/v4        + embedding-3
# OpenAI：  https://api.openai.com/v1                   + text-embedding-3-small
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v3
# 留空则回退使用 AI_API_KEY
EMBEDDING_API_KEY=
# 手动指定向量维度；留空按接口返回推断
EMBEDDING_DIM=
EMBEDDING_TIMEOUT_MS=30000

# 外部知识库（如 ima）：配置后 KB_RETRIEVER=remote 生效，未配置则自动退回关键词检索
EXTERNAL_KB_ENDPOINT=
EXTERNAL_KB_TOKEN=
EXTERNAL_KB_TIMEOUT_MS=10000

# ---------- 内嵌调度器（三种生成方式的执行侧）----------
# 关闭后只保留外部计划任务/CI 调用 CLI 的方式
SCHEDULER_ENABLED=true
# 巡检间隔（秒）：手动生成与定时生成都在这个粒度内被拾起
SCHEDULER_TICK_SEC=60
# 自动生成（队列）的批量消费间隔（小时），避免每轮巡检都调模型
SCHEDULER_QUEUE_INTERVAL_HOURS=20
